# Arahkan base URL langsung ke nama service 9Router di dalam Docker network
OPENAI_BASE_URL=http://nine-router:20128/v1
OPENAI_API_BASE=http://nine-router:20128/v1

# API Key untuk Hermes ke 9Router
OPENAI_API_KEY=your_9router_api_key_here

# Nama model yang diaktifkan di 9Router (misal: claude-3-5-sonnet, gpt-4o-mini, atau Hermes-Agent)
MODEL_NAME=Hermes-Agent

# Password awal untuk dashboard 9Router (http://localhost:20128)
INITIAL_PASSWORD=your_initial_password_here
